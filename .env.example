# Salin file ini menjadi .env lalu sesuaikan nilainya.
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=pbo2026_cashflow
DB_USERNAME=postgres
DB_PASSWORD=ganti_dengan_password_postgres

# Akun admin yang otomatis dibuat saat aplikasi pertama kali jalan
ROOT_USERNAME=admin
ROOT_PASSWORD=ganti_password_admin

# Folder penyimpanan foto profil dan bukti transaksi
UPLOAD_DIR=uploads
